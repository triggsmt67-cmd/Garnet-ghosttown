# WPGraphQL endpoint. Leave unset to run on built-in sample content.
# WORDPRESS_GRAPHQL_URL=https://cms.garnetghosttown.org/graphql

# Shared secret WordPress sends in the x-revalidate-secret header on save.
# Generate with: openssl rand -hex 32
# REVALIDATE_SECRET=

# Set to "true" ONLY on the real production deployment at launch.
# Anything else (preview deployments, staging) stays out of search engines.
# SITE_INDEXABLE=true
